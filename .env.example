# Google Calendar: OAuth 2.0 Client ID (type "Web application") from
# https://console.cloud.google.com/apis/credentials
# Copy this file to .env.local and fill in the value. .env.local is not committed.
VITE_GOOGLE_CLIENT_ID=

# Medicare API (medicare-Api repo). Defaults to http://localhost:8081/api when unset.
VITE_API_URL=http://localhost:8081/api
